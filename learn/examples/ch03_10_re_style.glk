// ch03_10_re_style.glk — 逆向风格小脚本：扫「特征」、汇总
// 模拟：在整数数组里找魔数，统计命中（不依赖 pe 模块，纯语言）
// .\gltk.exe run learn\examples\ch03_10_re_style.glk

import out

fn u16le(lo, hi) {
  return lo + hi * 256
}

fn find_all_u16(buf, magic) {
  // buf: 字节数组（0-255 的 int）
  let hits = []
  let i = 0
  // 手动收集：打印 hits，并返回计数（数组无 push 时用计数+打印）
  let count = 0
  while i + 1 < len(buf) {
    let v = u16le(buf[i], buf[i + 1])
    if v == magic {
      out.println("hit at offset", i, " u16=", v)
      // 记录偏移到「伪列表」：用 map 计数
      count = count + 1
    }
    i = i + 1
  }
  return count
}

fn main(args) {
  // 伪造一小段「文件」：中间嵌入 0x5A4D ('MZ' little-endian = 4D 5A)
  // LE: 4D 5A -> u16 = 0x5A4D
  let buf = [
    0x00, 0x01, 0x02, 0x03,
    0x4D, 0x5A,
    0x10, 0x20,
    0x4D, 0x5A,
    0xFF
  ]

  let mz = 0x5A4D
  out.println("searching magic", mz)
  let n = find_all_u16(buf, mz)
  out.println("total hits =", n)

  // 分支报告
  if n == 0 {
    out.println("REPORT: no MZ-like marker")
  } else if n == 1 {
    out.println("REPORT: single marker")
  } else {
    out.println("REPORT: multiple markers (possible overlays/copies)")
  }

  // switch 报告级别
  let level = n >= 2 ? 2 : n
  switch level {
    case 0:
      out.println("level=empty")
    case 1:
      out.println("level=single")
    case 2:
      out.println("level=multi")
    default:
      out.println("level=other")
  }

  return 0
}

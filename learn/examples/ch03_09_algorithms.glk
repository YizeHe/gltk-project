// ch03_09_algorithms.glk — 综合：查找、统计、简单状态
// .\gltk.exe run learn\examples\ch03_09_algorithms.glk

import out

fn contains(arr, target) {
  for v in arr {
    if v == target {
      return true
    }
  }
  return false
}

fn index_of(arr, target) {
  let i = 0
  while i < len(arr) {
    if arr[i] == target {
      return i
    }
    i = i + 1
  }
  return -1
}

fn count_if_even(arr) {
  let c = 0
  for v in arr {
    if v % 2 == 0 {
      c = c + 1
    }
  }
  return c
}

fn max_in(arr) {
  if len(arr) == 0 {
    return null
  }
  let m = arr[0]
  for v in arr {
    if v > m {
      m = v
    }
  }
  return m
}

// 简单字符串构建：连接 args
fn join_args(args, sep) {
  if len(args) == 0 {
    return ""
  }
  let s = "" + args[0]
  let i = 1
  while i < len(args) {
    s = s + sep + ("" + args[i])
    i = i + 1
  }
  return s
}

// 状态机：扫描是否出现模式 [1,2,1]
fn has_pattern_121(arr) {
  let state = 0
  for v in arr {
    if state == 0 {
      if v == 1 {
        state = 1
      }
    } else if state == 1 {
      if v == 2 {
        state = 2
      } else if v == 1 {
        state = 1
      } else {
        state = 0
      }
    } else if state == 2 {
      if v == 1 {
        return true
      } else if v == 2 {
        // stay? reset
        state = 0
      } else {
        state = 0
      }
    }
  }
  return false
}

fn main(args) {
  let data = [3, 1, 4, 1, 5, 9, 2, 6]

  out.println("contains 5?", contains(data, 5))
  out.println("contains 7?", contains(data, 7))
  out.println("index_of 9 =", index_of(data, 9))
  out.println("even count =", count_if_even(data))
  out.println("max =", max_in(data))

  out.println("join =", join_args(["pe", "fs", "out"], ", "))

  out.println("pattern 1,2,1 in [0,1,2,1]?", has_pattern_121([0, 1, 2, 1]))
  out.println("pattern in [1,1,2,3]?", has_pattern_121([1, 1, 2, 3]))

  // 命令行：把所有参数大写风格演示（无 str 模块时手写）
  if len(args) > 0 {
    out.println("args joined:", join_args(args, " | "))
  } else {
    out.println("(tip: pass args after -- )")
  }

  return 0
}

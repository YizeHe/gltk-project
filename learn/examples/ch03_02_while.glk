// ch03_02_while.glk — while / break / continue
// .\gltk.exe run learn\examples\ch03_02_while.glk

import out

fn main(args) {
  // 1) 计数
  let i = 0
  while i < 3 {
    out.println("i=", i)
    i = i + 1
  }

  // 2) continue：跳过本轮剩余语句
  let n = 0
  let sum = 0
  while n < 6 {
    n = n + 1
    if n % 2 == 0 {
      continue   // 偶数不累加
    }
    sum = sum + n
  }
  out.println("odd sum 1..6 =", sum) // 1+3+5=9

  // 3) break：离开循环
  let k = 0
  while true {
    k = k + 1
    if k >= 4 {
      break
    }
    out.println("k=", k)
  }
  out.println("stopped at k=", k)

  // 4) 组合：模拟扫描到标记
  let buf = [10, 20, 0, 40] // 0 表示结束标记
  let idx = 0
  let acc = 0
  while idx < len(buf) {
    let v = buf[idx]
    idx = idx + 1
    if v == 0 {
      out.println("hit sentinel at idx", idx - 1)
      break
    }
    if v < 15 {
      continue
    }
    acc = acc + v
  }
  out.println("acc=", acc) // 20

  return 0
}

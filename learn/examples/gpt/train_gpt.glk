import tensor
import out
// GrokTorch GPT-1 Training Script
// Trains a tiny GPT on Shakespeare text, predicts next character
// Loads data from shakespeare.txt

// ============================================================
//  Vocabulary and tokenizer
// ============================================================

fn build_vocab(text, max_vocab) {
  char_map = {}
  chars_arr = []
  i = 0
  while i < len(text) {
    ch = text[i]
    if !has(char_map, ch) {
      char_map[ch] = true
      push(chars_arr, ch)
    }
    i = i + 1
  }
  n = len(chars_arr)
  if n > max_vocab - 1 {
    n = max_vocab - 1
  }
  stoi = {}
  itos = {}
  j = 0
  while j < n {
    ch = chars_arr[j]
    stoi[ch] = j
    itos[to_str(j)] = ch
    j = j + 1
  }
  // unknown token as last slot
  stoi["?"] = n
  itos[to_str(n)] = "?"
  return {"stoi": stoi, "itos": itos, "vocab_size": n + 1}
}

fn encode(text, stoi, unk_id) {
  tokens = []
  i = 0
  while i < len(text) {
    ch = text[i]
    id = unk_id
    if has(stoi, ch) {
      id = stoi[ch]
    }
    push(tokens, id)
    i = i + 1
  }
  return tokens
}

fn decode(tokens, itos) {
  result = ""
  i = 0
  while i < len(tokens) {
    k = tokens[i]
    ks = to_str(k)
    if has(itos, ks) {
      result = result + itos[ks]
    } else {
      result = result + "?"
    }
    i = i + 1
  }
  return result
}

// ============================================================
//  Batch sampling
// ============================================================

fn get_batch(data, batch_size, seq_len, step) {
  n = len(data)
  if n < seq_len + 2 {
    return {"x": [[0]], "y": [[0]]}
  }
  batches_x = []
  batches_y = []
  b = 0
  while b < batch_size {
    start = (step * seq_len + b * seq_len) % (n - seq_len - 1)
    if start < 0 {
      start = start + n - seq_len - 1
    }
    x_tokens = []
    y_tokens = []
    i = 0
    while i < seq_len {
      push(x_tokens, data[start + i])
      push(y_tokens, data[start + i + 1])
      i = i + 1
    }
    push(batches_x, x_tokens)
    push(batches_y, y_tokens)
    b = b + 1
  }
  return {"x": batches_x, "y": batches_y}
}

// ============================================================
//  GPT Model
// ============================================================

fn gpt_init(cfg) {
  d = cfg["d_model"]
  v = cfg["vocab_size"]
  ff = cfg["ff_hidden"]
  max_seq = cfg["max_seq"]
  n_layers = cfg["n_layers"]

  tok_emb = tensor.mul(tensor.randn([v, d]), 0.02)
  pos_emb = tensor.mul(tensor.randn([max_seq, d]), 0.02)

  blocks = []
  li = 0
  while li < n_layers {
    b = {
      "ln1_g": tensor.ones([d]),
      "ln1_b": tensor.zeros([d]),
      "q_w": tensor.mul(tensor.randn([d, d]), 0.02),
      "q_b": tensor.zeros([d]),
      "k_w": tensor.mul(tensor.randn([d, d]), 0.02),
      "k_b": tensor.zeros([d]),
      "v_w": tensor.mul(tensor.randn([d, d]), 0.02),
      "v_b": tensor.zeros([d]),
      "proj_w": tensor.mul(tensor.randn([d, d]), 0.02),
      "proj_b": tensor.zeros([d]),
      "ln2_g": tensor.ones([d]),
      "ln2_b": tensor.zeros([d]),
      "ff1_w": tensor.mul(tensor.randn([ff, d]), 0.02),
      "ff1_b": tensor.zeros([ff]),
      "ff2_w": tensor.mul(tensor.randn([d, ff]), 0.02),
      "ff2_b": tensor.zeros([d])
    }
    push(blocks, b)
    li = li + 1
  }

  lnf_g = tensor.ones([d])
  lnf_b = tensor.zeros([d])
  head_w = tensor.mul(tensor.randn([v, d]), 0.02)
  head_b = tensor.zeros([v])

  return {
    "cfg": cfg,
    "tok_emb": tok_emb, "pos_emb": pos_emb,
    "blocks": blocks,
    "lnf_g": lnf_g, "lnf_b": lnf_b,
    "head_w": head_w, "head_b": head_b
  }
}

fn ln_forward(x, gamma, beta) {
  mv = tensor.to_value(tensor.mean(x))
  neg_mv = -mv
  c = tensor.add(x, neg_mv)
  vv = tensor.to_value(tensor.mean(tensor.mul(c, c)))
  n = tensor.div(c, tensor.to_value(tensor.sqrt(tensor.fill([1], vv + 1e-5))))
  return tensor.add(tensor.mul(n, gamma), beta)
}

fn gpt_forward(model, idx) {
  seq_len = len(idx)
  d = model["cfg"]["d_model"]

  pos = range(0, seq_len)
  te = tensor.embed_lookup(model["tok_emb"], idx)
  pe = tensor.embed_lookup(model["pos_emb"], pos)
  x = tensor.add(te, pe)

  blocks = model["blocks"]
  bi = 0
  while bi < len(blocks) {
    b = blocks[bi]

    // Pre-norm + attention
    n1 = ln_forward(x, b["ln1_g"], b["ln1_b"])
    q = tensor.add(tensor.matmul(n1, tensor.transpose(b["q_w"])), b["q_b"])
    k = tensor.add(tensor.matmul(n1, tensor.transpose(b["k_w"])), b["k_b"])
    v = tensor.add(tensor.matmul(n1, tensor.transpose(b["v_w"])), b["v_b"])
    ao = tensor.scaled_dot_product_attention(q, k, v)
    ap = tensor.add(tensor.matmul(ao, tensor.transpose(b["proj_w"])), b["proj_b"])
    x = tensor.add(x, ap)

    // Pre-norm + FF
    n2 = ln_forward(x, b["ln2_g"], b["ln2_b"])
    fh = tensor.add(tensor.matmul(n2, tensor.transpose(b["ff1_w"])), b["ff1_b"])
    fa = tensor.gelu(fh)
    fo = tensor.add(tensor.matmul(fa, tensor.transpose(b["ff2_w"])), b["ff2_b"])
    x = tensor.add(x, fo)

    bi = bi + 1
  }

  x = ln_forward(x, model["lnf_g"], model["lnf_b"])
  logits = tensor.add(tensor.matmul(x, tensor.transpose(model["head_w"])), model["head_b"])
  return logits
}

fn gpt_params(model) {
  p = []
  push(p, model["tok_emb"])
  push(p, model["pos_emb"])
  bi = 0
  while bi < len(model["blocks"]) {
    b = model["blocks"][bi]
    push(p, b["ln1_g"]); push(p, b["ln1_b"])
    push(p, b["q_w"]); push(p, b["q_b"])
    push(p, b["k_w"]); push(p, b["k_b"])
    push(p, b["v_w"]); push(p, b["v_b"])
    push(p, b["proj_w"]); push(p, b["proj_b"])
    push(p, b["ln2_g"]); push(p, b["ln2_b"])
    push(p, b["ff1_w"]); push(p, b["ff1_b"])
    push(p, b["ff2_w"]); push(p, b["ff2_b"])
    bi = bi + 1
  }
  push(p, model["lnf_g"]); push(p, model["lnf_b"])
  push(p, model["head_w"]); push(p, model["head_b"])
  return p
}

// ============================================================
//  Generation (autoregressive sampling with temperature)
// ============================================================

fn generate(model, prompt_tokens, max_new_tokens, itos, temperature) {
  out.println("")
  out.println("--- Generation (temp=" + temperature + ") ---")
  out.print("Prompt: " + decode(prompt_tokens, itos))
  out.print("Output: " + decode(prompt_tokens, itos))

  tokens = clone(prompt_tokens)
  i = 0
  while i < max_new_tokens {
    ctx_len = len(tokens)
    if ctx_len > model["cfg"]["max_seq"] {
      ctx_len = model["cfg"]["max_seq"]
    }
    ctx_start = len(tokens) - ctx_len
    ctx = []
    j = ctx_start
    while j < len(tokens) {
      push(ctx, tokens[j])
      j = j + 1
    }

    // Forward pass (no tape needed for generation — grad disabled)
    logits = gpt_forward(model, ctx)
    last_row = tensor.slice_2d(logits, ctx_len - 1, ctx_len, 0, model["cfg"]["vocab_size"])
    // Temperature sampling
    next_token = tensor.sample(last_row, temperature)

    push(tokens, next_token)
    ks = to_str(next_token)
    if has(itos, ks) {
      out.print(itos[ks])
    } else {
      out.print("?")
    }
    i = i + 1
  }
  out.println("")
}

// ============================================================
//  Main training
// ============================================================

fn main(args) {
  out.println("=== GrokTorch GPT-1 Training ===")

  // Load training data from file
  out.println("Loading shakespeare.txt...")
  if !exists("learn\\examples\\gpt\\shakespeare.txt") {
    out.println("ERROR: shakespeare.txt not found. Run from gltk/ directory.")
    return 1
  }
  fh = open("learn\\examples\\gpt\\shakespeare.txt")
  shakespeare_text = read(fh)
  close(fh)
  out.println("Loaded " + len(shakespeare_text) + " characters")

  // Config
  cfg = {
    "vocab_size": 64,
    "d_model": 64,
    "n_heads": 4,
    "n_layers": 6,
    "ff_hidden": 256,
    "max_seq": 48
  }
  batch_size = 2
  seq_len = 48
  train_steps = 4000
  lr = 5e-4

  // Build vocab
  out.println("Building vocabulary...")
  vocab = build_vocab(shakespeare_text, cfg["vocab_size"])
  cfg["vocab_size"] = vocab["vocab_size"]
  out.println("Vocab size: " + vocab["vocab_size"])

  // Encode and repeat data
  raw_data = encode(shakespeare_text, vocab["stoi"], vocab["vocab_size"] - 1)
  data = []
  // Repeat 20x for ~260K tokens
  rep = 0
  while rep < 20 {
    i = 0
    while i < len(raw_data) {
      push(data, raw_data[i])
      i = i + 1
    }
    rep = rep + 1
  }
  out.println("Data tokens: " + len(data))

  // Create model
  out.println("Creating model...")
  model = gpt_init(cfg)
  params = gpt_params(model)
  total = 0
  pi = 0
  while pi < len(params) {
    total = total + tensor.numel(params[pi])
    pi = pi + 1
  }
  out.println("Parameters: " + total)

  // Enable autograd
  tensor.enable_grad()

  // Training loop
  out.println("Starting training (" + train_steps + " steps)...")
  step = 0
  while step < train_steps {
    // Linear LR warmup then constant
    cur_lr = lr
    if step < 200 {
      cur_lr = lr * step / 200.0
    }

    // Get batch
    batch = get_batch(data, batch_size, seq_len, step)
    batch_x = batch["x"]
    batch_y = batch["y"]

    // Accumulate loss over batch
    total_loss = 0.0
    bi = 0
    while bi < batch_size {
      x_tokens = batch_x[bi]
      y_tokens = batch_y[bi]

      // Forward
      logits = gpt_forward(model, x_tokens)
      loss_tensor = tensor.cross_entropy(logits, y_tokens)
      total_loss = total_loss + tensor.to_value(loss_tensor)

      // Backward
      tensor.backward(loss_tensor)

      bi = bi + 1
    }

    // Adam step
    adam_t = step + 1.0
    tensor.step_adam(params, cur_lr, 0.9, 0.999, 1e-8, adam_t)
    tensor.zero_grad(params)

    // Periodic GC
    if step % 100 == 0 {
      tensor.force_gc()
    }

    // Logging
    if step % 100 == 0 {
      avg_loss = total_loss / batch_size
      out.println("step " + step + " loss=" + avg_loss + " lr=" + cur_lr)
    }

    step = step + 1
  }

  // Final GC
  tensor.force_gc()

  // Disable grad for generation
  tensor.disable_grad()

  // Generate samples with different temperatures
  out.println("")
  out.println("Training complete! Generating samples...")

  prompt_text = "First Citizen:"
  prompt = encode(prompt_text, vocab["stoi"], vocab["vocab_size"] - 1)
  generate(model, prompt, 200, vocab["itos"], 0.8)
  generate(model, prompt, 200, vocab["itos"], 1.0)

  prompt_text2 = "Marcius:"
  prompt2 = encode(prompt_text2, vocab["stoi"], vocab["vocab_size"] - 1)
  generate(model, prompt2, 200, vocab["itos"], 0.8)

  prompt_text3 = "Menenius Agrippa:"
  prompt3 = encode(prompt_text3, vocab["stoi"], vocab["vocab_size"] - 1)
  generate(model, prompt3, 200, vocab["itos"], 0.8)

  out.println("=== Done ===")
  return 0
}

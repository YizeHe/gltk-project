// upx_unpack.glk — pure GLTK UPX PE unpacker (no external upx.exe required)
// Usage:
//   gltk run samples/upx_unpack.glk -- <packed.exe> [out.exe]
import upx, pe, fs, out

fn main(args) {
  if len(args) < 1 {
    out.println("usage: gltk run upx_unpack.glk -- <packed.exe> [out.exe]")
    return 1
  }
  let inp = args[0]
  if !fs.exists(inp) {
    out.println("missing", inp)
    return 1
  }
  let info = upx.info(inp)
  out.println("is_upx=", info.is_upx, " version=", info.version_str, " method=", info.method)
  out.println("u_len=", info.u_len, " c_len=", info.c_len, " filter=", info.filter)
  if info.is_upx != true {
    out.println("not UPX packed")
    return 2
  }
  let outp = inp + ".unpacked.exe"
  if len(args) >= 2 {
    outp = args[1]
  }
  let r = upx.unpack(inp, outp)
  if r.ok != true {
    out.println("FAIL", r.error)
    return 3
  }
  out.println("WROTE", outp, " size=", r.size)
  out.println("note=", r.note)
  let s = pe.summary(outp)
  out.println("unpacked sections=", s.section_count, " imports=", s.import_count)
  if typeof(s.sections) == "array" {
    let i = 0
    while i < len(s.sections) {
      out.println(" ", s.sections[i].name, " raw=", s.sections[i].rawsize)
      i = i + 1
    }
  }
  return 0
}

import http, out, crypto, str
fn main(args) {
  let domains = ["US122201.ssgreen.org", "US032010.westmgreen.com", "edge2nl01.westmgreen.com"]
  let uid = crypto.uuid4()
  let i = 0
  while i < len(domains) {
    let d = domains[i]
    let u1 = "https://" + d + "/d/v1/status?uid=" + uid + "&version=2.2.0&platform=win32"
    let u2 = "https://" + d + "/v1/status?uid=" + uid + "&version=2.2.0&platform=win32"
    let r1 = http.get(u1, 12)
    let r2 = http.get(u2, 12)
    out.println(d, " /d/v1/status", r1.status, r1.error, r1.body)
    out.println(d, " /v1/status", r2.status, r2.error, r2.body)
    i = i + 1
  }
  return 0
}
